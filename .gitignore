*.f64
corpus_ids.txt
results/retrieval_pilot/*_full.tsv
results/retrieval_pilot/query_clone_types.tsv
results/timing/*.tsv

# LaTeX build files
paper/*.aux
paper/*.log
paper/preview.pdf
exp_v2/paper/*.aux
exp_v2/paper/*.log
exp_v2/paper/preview.pdf
