# Tooling and downloads
.venv/
third_party/
elasticsearch-*/
__pycache__/
kernels/target/

# Bulk data (BCB dump, trees, embeddings, models); keep the small query/fold definitions
data/*
!data/pools/
!data/corpus/
!data/derived_components.tsv
!data/codebert/
data/codebert/*
!data/codebert/folds.tsv
!data/codebert/query_folds.tsv

# Raw run outputs: score matrices and per-run id lists (regenerable); summaries stay tracked
*.f64
corpus_ids.txt
results/retrieval_pilot/*_full.tsv
results/retrieval_pilot/query_clone_types.tsv
results/timing/*.tsv

# LaTeX build files
paper/*.aux
paper/*.log
paper/preview.pdf
exp_v2/paper/*.aux
exp_v2/paper/*.log
exp_v2/paper/preview.pdf
# exp_v2 hybrid intermediates (regenerable by exp_v2/scripts/run_hybrid.sh): BM25 top-200 lists, pair scores; timing kept
exp_v2/results/hybrid/stage1/topk.tsv
exp_v2/results/hybrid/pairs*/*.tsv
!exp_v2/results/hybrid/pairs*/*.timing.tsv
exp_v2/kernels/classes/
# exp_v2: CodeBERT fine-tuned with false positives; keep the training logs and timings, not the weights or embeddings
!data/codebert/models_fp/
data/codebert/models_fp/*/model.safetensors
!data/codebert/emb/
data/codebert/emb/*
!data/codebert/emb/fpft_fold*_e5.npy.json
# previous CodeBERT ft results (true-positive models), moved aside by exp_v2/scripts/rerun_codebert_ft.sh; the tracked
# summaries are in git history (commit 818aa47)
exp_v2/results/archive_codebert_tp/
# exp_v3_all_queries: fragment cache (regenerable by exp_v3_all_queries/eval/trees.py) and LaTeX output
exp_v3_all_queries/results/diagnostics/fragments.npz
exp_v3_all_queries/paper/*.aux
exp_v3_all_queries/paper/*.log
exp_v3_all_queries/paper/*.out
exp_v3_all_queries/paper/paper.pdf
# exp_v3_all_queries: kernel rankings (24 GB, too large for git), LaTeX/draft output, and personal notes
exp_v3_all_queries/results/runs/
exp_v3_all_queries/paper/*.pdf
exp_v3_all_queries/paper/*.synctex.gz
exp_v3_all_queries/paper/build.log
exp_v3_all_queries/Oct/*.aux
exp_v3_all_queries/Oct/*.bbl
exp_v3_all_queries/Oct/*.blg
exp_v3_all_queries/Oct/*.log
exp_v3_all_queries/Oct/*.out
exp_v3_all_queries/Oct/*.pdf
exp_v3_all_queries/Oct/*.synctex.gz
exp_v3_all_queries/summary
exp_v3_all_queries/wilcoxon or CIs
exp_v3_all_queries/diagnostic_explain.md
